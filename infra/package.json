{
  "name": "@med-ocr/rules-tests",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Firestore security rules unit tests. Standalone (not a pnpm workspace member) so it does not require a root package.json change.",
  "scripts": {
    "test": "firebase emulators:exec --config ../firebase.json --only firestore --project demo-med-ocr \"vitest run\"",
    "test:watch": "firebase emulators:exec --config ../firebase.json --only firestore --project demo-med-ocr \"vitest\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.4.0",
    "firebase-tools": "^15.37.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
