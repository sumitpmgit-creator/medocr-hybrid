rules_version = '2';

// MedOCR Hybrid Firestore rules.
//
// App Check enforcement is NOT configured here. It is turned on in the
// Firebase console (or API) for Cloud Firestore and for Firebase AI Logic.
// See infra/setup-steps.md. Rules only see request.auth; they cannot enforce
// App Check tokens.
//
// Decision: Firestore stores metrics only. No results text (no medications,
// lab values, transcripts, or structured clinical JSON). Images and raw PII
// stay forbidden. The only writable path is users/{uid}/runs/{runId}, as
// written by apps/web/src/firebase.ts (saveRunSummary) and apps/web/src/main.ts:
//   pipelineId, cer, wer, fieldF1, latencyMs, bytesSent, costUsd, failed,
//   createdAt (serverTimestamp).
// users/{uid}/results and every other path fall under deny-by-default.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.uid is string
        && request.auth.uid.size() > 0;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function strMax(v, n) {
      return v is string && v.size() <= n;
    }

    function nonNeg(v) {
      return v is number && v >= 0;
    }

    // CER/WER can exceed 1.0 (packages/core/src/text-metrics.ts).
    function errorRateOrNull(v) {
      return v == null || (v is number && v >= 0 && v <= 10);
    }

    function unitIntervalOrNull(v) {
      return v == null || (v is number && v >= 0 && v <= 1);
    }

    function noForbiddenKeys(data) {
      return !data.keys().hasAny([
        'image', 'images', 'base64', 'photo', 'pdf', 'mimeType',
        'raw', 'rawText', 'transcript', 'ocrText', 'pageText',
        'pii', 'patientName', 'dateOfBirth', 'dob', 'phone',
        'email', 'address', 'aadhaar', 'abha', 'mrn', 'uhid',
        'medications', 'labResults', 'abstentions', 'readingText',
        'disagreements', 'humanDecisions', 'documentType'
      ]);
    }

    function runKeysAllowed(data) {
      return data.keys().hasOnly([
        'createdAt', 'pipelineId', 'cer', 'wer', 'fieldF1',
        'latencyMs', 'bytesSent', 'costUsd', 'failed',
        'runId', 'docId', 'error',
        'stepSummaries', 'sites', 'toCloudCount', 'humanConfirmCount',
        'acceptOnDeviceThreshold', 'humanReviewThreshold',
        'datasetId', 'datasetLicense', 'passesSafetyScreen'
      ]);
    }

    function validRun(data) {
      return runKeysAllowed(data)
        && noForbiddenKeys(data)
        && data.createdAt is timestamp
        && strMax(data.pipelineId, 64)
        && data.failed is bool
        && nonNeg(data.latencyMs)
        && nonNeg(data.bytesSent)
        && nonNeg(data.costUsd)
        && (!('cer' in data) || errorRateOrNull(data.cer))
        && (!('wer' in data) || errorRateOrNull(data.wer))
        && (!('fieldF1' in data) || unitIntervalOrNull(data.fieldF1))
        && (!('error' in data) || data.error == null || strMax(data.error, 2000))
        && (!('runId' in data) || strMax(data.runId, 128))
        && (!('docId' in data) || strMax(data.docId, 128))
        && (!('datasetId' in data) || strMax(data.datasetId, 128))
        && (!('datasetLicense' in data) || strMax(data.datasetLicense, 64))
        && (!('sites' in data) || (data.sites is list && data.sites.size() <= 20))
        && (!('stepSummaries' in data)
          || (data.stepSummaries is list && data.stepSummaries.size() <= 30))
        && (!('toCloudCount' in data) || nonNeg(data.toCloudCount))
        && (!('humanConfirmCount' in data) || nonNeg(data.humanConfirmCount))
        && (!('acceptOnDeviceThreshold' in data) || unitIntervalOrNull(data.acceptOnDeviceThreshold))
        && (!('humanReviewThreshold' in data) || unitIntervalOrNull(data.humanReviewThreshold))
        && (!('passesSafetyScreen' in data) || data.passesSafetyScreen == null || data.passesSafetyScreen is bool);
    }

    match /users/{uid} {
      allow read, write: if false;

      match /runs/{runId} {
        allow read: if isUser(uid);
        allow create: if isUser(uid) && validRun(request.resource.data);
        allow update: if isUser(uid)
          && validRun(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isUser(uid);
      }
    }
  }
}
