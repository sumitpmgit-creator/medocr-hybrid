# Copy to .env.local and fill from Firebase console > Project settings > Your apps (Web).
# These are NOT secrets but must never be invented; leave blank until you have them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check: reCAPTCHA Enterprise site key (Firebase console > App Check > Apps)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Set to "true" only on localhost to print an App Check debug token (register it in the console). Never commit a real token.
VITE_APPCHECK_DEBUG=true
